# Bloc HTTPS (écoute sur le port 443 interne, mappé sur 8443)
:443 {
    tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem

    handle /api/* {
        reverse_proxy backend:3001
    }

    handle /socket.io/* {
        reverse_proxy backend:3001
    }

    handle {
        reverse_proxy frontend:3000
    }
}

:80 {
    redir https://{host}:8443{uri} permanent
}