generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. UTILISATEURS & AUTHENTIFICATION
// ==========================================
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  password     String?  // Nullable car OAuth (42, Google) n'a pas de mot de passe local
  avatarUrl    String @default("https://i.imgur.com/pOm90d7.jpeg")

  // Statut & OAuth
  isOnline     Boolean  @default(false)
  isBot        Boolean  @default(false) // Pour distinguer l'IA si créée en DB
  oauthProvider String? // ex: "42", "google"
  oauthId      String?  // ID distant du provider
  @@unique([oauthProvider, oauthId]) // Évite les doublons d'un même compte externe

  // Statistiques de jeu[eslint] EACCES: permission denied, open '/home/bbeaurai/Code/ft_transcendence/frontend/node_modules/.cache/.eslintcache'
  wins         Int      @default(0)
  losses       Int      @default(0)
  elo          Int      @default(100)

  // Timestamps
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastSeenAt   DateTime?

  gamesAsPlayer1         Game[]                  @relation("GamePlayer1")
  gamesAsPlayer2         Game[]                  @relation("GamePlayer2")
  moves                  GameMove[]              @relation("GameMovePlayer")

  @@index([email])
  @@index([username])
}


// ==========================================
// 3. JEU (PIERRE-FEUILLE-CISEAUX) & CUSTOMISATION
// ==========================================
model Game {
  id           String     @id @default(cuid())
  tournamentId String?
  player1Id    String
  player2Id    String?    // Nullable au début pour le matchmaking
  winnerId     String?
  status       GameStatus @default(WAITING)

  // Score final de la partie
  scorePlayer1 Int        @default(0)
  scorePlayer2 Int        @default(0)

  // Option de customisation (Game Customization Module)
  maxScore     Int        @default(3)   // Ex: Premier à 3 points gagne
  roundTimeout Int        @default(10)  // Temps max par manche en secondes

  createdAt    DateTime   @default(now())
  endedAt      DateTime?

  // Relations
  player1    User        @relation(fields: [player1Id], references: [id], name: "GamePlayer1", onDelete: Cascade)
  player2    User?       @relation(fields: [player2Id], references: [id], name: "GamePlayer2", onDelete: Cascade)
  moves      GameMove[]
}

enum GameStatus {
  WAITING
  PLAYING
  FINISHED
  CANCELLED
}

model GameMove {
  id        String   @id @default(cuid())
  gameId    String
  playerId  String
  round     Int      // Numéro du round (1, 2, 3...)
  move      MoveType // ROCK, PAPER, SCISSORS
  createdAt DateTime @default(now())

  game   Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player User @relation(fields: [playerId], references: [id], name: "GameMovePlayer", onDelete: Cascade)
}

enum MoveType {
  ROCK
  PAPER
  SCISSORS
}
