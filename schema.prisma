// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  password    String    // Stocké hashé (bcrypt)
  username    String    @unique
  avatarUrl   String?
  isOnline    Boolean   @default(false)
  wins        Int       @default(0)
  losses      Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastSeenAt  DateTime?

  // Relations
  sentMessages    Message[]      @relation("SentMessages")
  receivedMessages Message[]     @relation("ReceivedMessages")
  friendships1     Friendship[]   @relation("FriendshipUser1")
  friendships2     Friendship[]   @relation("FriendshipUser2")
  gamesAsPlayer1  Game[]          @relation("GamePlayer1")
  gamesAsPlayer2  Game[]          @relation("GamePlayer2")
  gamesWon        Game[]          @relation("GameWinner")
  tournamentParticipants TournamentParticipant[]
  notifications   Notification[]
  games           GameMove[]
}

model Friendship {
  id        String   @id @default(cuid())
  user1Id   String
  user2Id   String
  status    String   @default("pending") // "pending", "accepted", "blocked"
  createdAt DateTime @default(now())

  // Relations
  user1 User @relation(fields: [user1Id], references: [id], name: "FriendshipUser1")
  user2 User @relation(fields: [user2Id], references: [id], name: "FriendshipUser2")

  // Contrainte unique pour éviter les doublons (user1 < user2)
  @@unique([user1Id, user2Id])
}

model Game {
  id           String    @id @default(cuid())
  tournamentId String?
  player1Id    String
  player2Id    String?
  winnerId     String?
  status       String    @default("waiting") // "waiting", "playing", "finished", "cancelled"
  createdAt    DateTime  @default(now())
  endedAt      DateTime?

  // Relations
  player1 User @relation(fields: [player1Id], references: [id], name: "GamePlayer1")
  player2 User? @relation(fields: [player2Id], references: [id], name: "GamePlayer2")
  winner  User? @relation(fields: [winnerId], references: [id], name: "GameWinner")
  tournament Tournament? @relation(fields: [tournamentId], references: [id])
  moves    GameMove[]
}

model GameMove {
  id        String   @id @default(cuid())
  gameId    String
  playerId  String
  move      String   // "rock", "paper", "scissors"
  createdAt DateTime @default(now())

  // Relations
  game   Game @relation(fields: [gameId], references: [id])
  player User @relation(fields: [playerId], references: [id])
}

model Tournament {
  id           String    @id @default(cuid())
  name         String
  organizerId  String
  status       String    @default("pending") // "pending", "started", "finished", "cancelled"
  maxPlayers   Int       @default(8)
  currentRound Int       @default(1)
  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  endedAt      DateTime?

  // Relations
  organizer   User                 @relation(fields: [organizerId], references: [id])
  participants TournamentParticipant[]
  games       Game[]
}

model TournamentParticipant {
  id              String    @id @default(cuid())
  tournamentId    String
  userId          String
  bracketPosition Int
  status          String    @default("registered") // "registered", "playing", "eliminated", "winner"
  points          Int       @default(0)

  // Relations
  tournament Tournament @relation(fields: [tournamentId], references: [id])
  user         User      @relation(fields: [userId], references: [id])
}

model Message {
  id           String   @id @default(cuid())
  senderId     String
  receiverId   String
  content      String
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())

  // Relations
  sender   User @relation(fields: [senderId], references: [id], name: "SentMessages")
  receiver User @relation(fields: [receiverId], references: [id], name: "ReceivedMessages")
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  type       String   // "friend_request", "game_invite", "tournament_start", "message"
  title      String
  message    String
  isRead     Boolean  @default(false)
  relatedId  String?  // ID lié (ex: ID de la Friendship ou Game)
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])
}